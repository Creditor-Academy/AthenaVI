pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Nginx Reload') {
            steps {
                sh '''
                    sudo nginx -t
                    sudo systemctl restart nginx
                '''
            }
        }
    }

    post {
        success {
            echo 'Frontend build and Nginx reload completed successfully.'
        }

        failure {
            echo 'Frontend pipeline failed.'
        }
    }
}
