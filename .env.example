# Frontend env template. Copy to .env.local (gitignored) and fill in.
#   cp .env.example .env.local
#
# Vite only exposes keys that start with VITE_ to the browser.
# Do not put OpenAI, HeyGen, AWS, JWT, SMTP, or database secrets here.
# Those belong in AthenaVI_backend/.env.development.
#
# Keep only one VITE_API_BASE_URL line uncommented. No trailing slash.

# Local backend
VITE_API_BASE_URL=http://localhost:9000
VITE_ENV=development

# Live API (Jenkins prod). Uncomment these two and comment the local pair to test against live.
# VITE_API_BASE_URL=https://api.vs.lmsathena.com
# VITE_ENV=production
